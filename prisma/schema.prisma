// ============================================================================
// Planeta.id — Database Schema
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth Models (NextAuth v5 + WebAuthn)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  webauthnCredentials WebAuthnCredential[]
  profile            UserProfile?
  savedJobs          SavedJob[]
  applications       Application[]
  userSkills         UserSkill[]
  offers             Offer[]
  signals            UserSignal[]
  gameProfile        GameProfile?
  badges             UserBadge[]
  quests             UserQuest[]
  notifications      Notification[]
  referralsGiven     Referral[]         @relation("ReferralGiver")
  referralsReceived  Referral[]         @relation("ReferralReceiver")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WebAuthnCredential {
  id                   String   @id @default(cuid())
  userId               String
  credentialId         String   @unique
  publicKey            Bytes
  counter              BigInt
  transports           String[]
  credentialDeviceType String
  credentialBackedUp   Boolean
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Profile Models
// ============================================================================

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  headline              String?
  bio                   String?  @db.Text
  location              String?
  country               String?
  avatarUrl             String?
  linkedinUrl           String?
  githubUrl             String?
  websiteUrl            String?
  yearsOfExperience     Int      @default(0)
  currentTitle          String?
  desiredTitle          String?
  desiredSalaryMin      Int?
  desiredSalaryMax      Int?
  desiredSalaryCurrency String   @default("USD")
  openToRemote          Boolean  @default(true)
  openToRelocation      Boolean  @default(false)
  onboardingCompleted   Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences WorkExperience[]
  educations      Education[]
}

model WorkExperience {
  id          String    @id @default(cuid())
  profileId   String
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  institution String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Job Models
// ============================================================================

enum JobType {
  full_time
  part_time
  contract
  freelance
  internship
}

enum JobLevel {
  intern
  junior
  mid
  senior
  lead
  principal
  director
  vp
  c_level
}

enum RemotePolicy {
  remote
  hybrid
  onsite
}

model Job {
  id             String       @id @default(cuid())
  title          String
  company        String
  companyLogo    String?
  companyDomain  String?
  location       String
  country        String
  remotePolicy   RemotePolicy @default(onsite)
  type           JobType      @default(full_time)
  level          JobLevel     @default(mid)
  description    String       @db.Text
  requirements   String[]
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String       @default("USD")
  salaryPeriod   String       @default("yearly")
  postedAt       DateTime     @default(now())
  expiresAt      DateTime?
  applicationUrl String?
  featured       Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  skills       JobSkill[]
  savedBy      SavedJob[]
  applications Application[]

  @@index([country, remotePolicy])
  @@index([level, type])
  @@index([postedAt])
}

model JobSkill {
  id       String  @id @default(cuid())
  jobId    String
  skillId  String
  required Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

enum ApplicationStatus {
  saved
  applied
  screening
  interviewing
  offered
  accepted
  rejected
  withdrawn
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  status      ApplicationStatus @default(applied)
  coverLetter String?           @db.Text
  resumeUrl   String?
  notes       String?           @db.Text
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([status])
}

// ============================================================================
// Skill Models
// ============================================================================

enum SkillCategory {
  technical
  soft
  domain
  tool
  language
  certification
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  category    SkillCategory @default(technical)
  parentId    String?
  description String?       @db.Text
  demandScore Float         @default(0)
  growthRate  Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent   Skill?     @relation("SkillHierarchy", fields: [parentId], references: [id])
  children Skill[]    @relation("SkillHierarchy")
  jobs     JobSkill[]
  users    UserSkill[]

  @@index([category])
}

enum SkillLevel {
  beginner
  intermediate
  advanced
  expert
}

model UserSkill {
  id                String     @id @default(cuid())
  userId            String
  skillId           String
  level             SkillLevel @default(beginner)
  yearsOfExperience Float      @default(0)
  verified          Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

// ============================================================================
// Salary Models
// ============================================================================

model SalaryDataPoint {
  id                String   @id @default(cuid())
  title             String
  level             JobLevel
  location          String
  country           String
  company           String?
  baseSalary        Int
  totalCompensation Int
  currency          String   @default("USD")
  yearsOfExperience Int
  reportedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([title, country, level])
  @@index([company])
}

model CompanySalaryProfile {
  id            String   @id @default(cuid())
  company       String
  companyDomain String?
  title         String
  level         JobLevel
  location      String
  baseSalaryP25 Int
  baseSalaryP50 Int
  baseSalaryP75 Int
  totalCompP25  Int
  totalCompP50  Int
  totalCompP75  Int
  currency      String   @default("USD")
  sampleSize    Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([company, title, level, location])
}

model Offer {
  id           String    @id @default(cuid())
  userId       String
  company      String
  title        String
  baseSalary   Int
  bonus        Int?
  equity       Int?
  signingBonus Int?
  currency     String    @default("USD")
  location     String?
  remotePolicy String?
  startDate    DateTime?
  deadline     DateTime?
  notes        String?   @db.Text
  accepted     Boolean?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Signal Models
// ============================================================================

model Signal {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?  @db.Text
  source      String?
  sourceUrl   String?
  relevance   Float    @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  users UserSignal[]
}

model UserSignal {
  id        String   @id @default(cuid())
  userId    String
  signalId  String
  seen      Boolean  @default(false)
  saved     Boolean  @default(false)
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([userId, signalId])
}

// ============================================================================
// Gamification Models
// ============================================================================

model GameProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String
  category    String
  xpReward    Int      @default(0)
  createdAt   DateTime @default(now())

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Quest {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  type        String
  xpReward    Int      @default(0)
  requirement Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  users UserQuest[]
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

// ============================================================================
// Company Model
// ============================================================================

model Company {
  id           String   @id @default(cuid())
  name         String   @unique
  domain       String?  @unique
  logo         String?
  description  String?  @db.Text
  industry     String?
  size         String?
  founded      Int?
  headquarters String?
  country      String?
  website      String?
  linkedinUrl  String?
  glassdoorUrl String?
  healthScore  Float?
  cultureScore Float?
  growthScore  Float?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================================
// Notification Model
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ============================================================================
// Referral Model
// ============================================================================

model Referral {
  id         String    @id @default(cuid())
  code       String    @unique
  giverId    String
  receiverId String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?

  giver    User  @relation("ReferralGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver User? @relation("ReferralReceiver", fields: [receiverId], references: [id])
}
